# Copy to .env and edit. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite for local dev. Set USE_SQLITE=False and fill DB_* for PostgreSQL.
USE_SQLITE=True
DB_NAME=acadex
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional Redis cache (falls back to local memory)
REDIS_URL=

# Moderation: a post is hidden after this many open flags
FLAG_HIDE_THRESHOLD=3

# Demo accounts created by 'manage.py seed_demo' (local development only). Leave empty to generate a random one.
DEMO_PASSWORD=
