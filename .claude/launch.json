{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "acadex",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "acadex-frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "acadex-api",
      "runtimeExecutable": "acadex-backend/.venv/bin/python",
      "runtimeArgs": [
        "acadex-backend/manage.py",
        "runserver",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "acadex-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "acadex/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "acadex-express-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "acadex/api",
        "run",
        "dev"
      ],
      "port": 4000
    }
  ]
}