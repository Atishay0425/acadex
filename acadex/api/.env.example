# Copy to .env and edit. Never commit .env.
PORT=4000
# Homebrew PostgreSQL trusts your Mac user, so no password: postgres://localhost/acadex
DATABASE_URL=postgres://localhost/acadex
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used by `npm run seed` (local development only). Leave empty to get a random one printed.
DEMO_PASSWORD=

# Notifications. In-app notifications always work. Leave these empty to skip email / web push.
WEB_URL=http://localhost:3000
SMTP_URL=
MAIL_FROM=Acadex <no-reply@your-college.edu>
# Generate keys once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-college.edu

# Optional. With Redis, rate limits are shared across API processes and some admin summaries are cached for 30-60 seconds.
REDIS_URL=

# Where uploaded files (assignment attachments, class materials) are kept. Back this folder up.
UPLOAD_DIR=uploads
